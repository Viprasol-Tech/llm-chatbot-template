# LLM Chatbot Template — example environment.
# Copy to .env and edit. NEVER commit your real .env (it is gitignored).
# All variables are optional; the app runs fully offline with the defaults below.

# Provider: "fake" (offline, default) or "openai" (OpenAI-compatible backend).
CHATBOT_PROVIDER=fake

# Default system prompt and per-turn token budget for trimming.
CHATBOT_SYSTEM_PROMPT=You are a helpful, concise assistant.
CHATBOT_MAX_TOKENS=1024

# --- Only used when CHATBOT_PROVIDER=openai ---
CHATBOT_OPENAI_MODEL=gpt-4o-mini
# CHATBOT_OPENAI_API_KEY=sk-your-key-here
# Point at any OpenAI-compatible server (OpenAI, Groq, Together, Ollama, …):
# CHATBOT_OPENAI_BASE_URL=https://api.openai.com/v1
